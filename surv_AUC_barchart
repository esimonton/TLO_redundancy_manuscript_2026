```{r}
# Contruct an area under the curve (AUC) as a barchart to better show all the genotypes equally; daily survival counts per genotype is the summary statistic we will be using

library(survival)
library(dplyr)

# Use your data
df <- in_df$TLO_comb

library(dplyr)

# Define the maximum day to consider (e.g., 7)
max_day <- 7

# For each genotype, calculate AUC as sum over days of (survivors * day)
auc_df <- df %>%
  group_by(Genotype) %>%
  do({
    genotype_df <- .
    
    # For days 1 to max_day, count larvae alive (Days >= day)
    daily_survivors <- sapply(1:max_day, function(day) {
      sum(genotype_df$Days >= day)
    })
    
    # Calculate AUC as sum(day * survivors)
    auc <- sum(daily_survivors * 1:max_day)
    
    data.frame(AUC = auc)
  }) %>%
  ungroup()

print(auc_df)

```

```{r}
#Recalculate AUC based on pooled data since there is a fair amount of statistical noise

max_day <- 7

auc_summary <- df %>%
  group_by(Genotype) %>%
  summarise(
    AUC = sum(sapply(1:max_day, function(day) sum(Days >= day))),
    .groups = "drop"
  )

```

```{r}
#Plot barchart
#install.packages("ggtext")  # if not installed
library(ggtext)

labels <- levels(auc_summary$Genotype)

label_map <- setNames(
  ifelse(labels %in% c("WT", "PBS"), labels, paste0("<i>", labels, "</i>")),
  labels
)


auc_summary$Genotype <- gsub("\\.", "/", auc_summary$Genotype)
auc_summary$Genotype <- factor(auc_summary$Genotype, levels = names(genotype_colors))

# #Use the following to have actual order based on auc
# auc_summary <- auc_summary %>%
#   arrange(desc(AUC)) %>%
#   mutate(Genotype = factor(Genotype, levels = Genotype))


auc_plot <- ggplot(auc_summary, aes(x = Genotype, y = AUC, fill = Genotype)) +
  geom_bar(stat = "identity", color = "black", width = 0.8) +
  scale_fill_manual(values = genotype_colors) +
  scale_x_discrete(labels=label_map) +
  labs(y = "Total AUC (Larvae × Days Survived)", x = "Genotype") +
  theme_minimal(base_size=20) +
  theme(
    axis.text.x = element_markdown(angle = 45, hjust = 1, size = 20, face = "italic"),
    legend.position = "none"
  )

ggsave(auc_plot, file = "auc_galleria_comb_delta.png", dpi = 300)
