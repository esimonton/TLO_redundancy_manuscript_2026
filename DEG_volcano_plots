tlo1_DEGs <- read_xlsx("C:/Users/simonton/OneDrive - UW-Madison/Research/RNAseq/tlo_DEGs_comb_DESeq2_align2.xlsx", sheet = "tlo1")
tlo1_shrink_filtered <- read.csv("C:/Users/simonton/OneDrive - UW-Madison/Research/RNAseq/tlo_misc_DESeq2_files/tlo1_shrink_filtered.csv")

# Create a new column to classify genes based on significance and fold change
tlo1_shrink_filtered$diff_expression <- with(tlo1_shrink_filtered, 
  ifelse(padj < 0.05 & log2FoldChange > 1, "Upregulated",
    ifelse(padj < 0.05 & log2FoldChange < -1, "Downregulated", "Non-significant"))
)

# Check if the new column was created correctly
table(tlo1_shrink_filtered$diff_expression)



