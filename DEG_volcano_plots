  "path_to_images/tlo34.tlo2_DEG_volcano_logcutoff_labelled.png",
  "path_to_images/tlo9.tlo10_DEG_volcano_logcutoff_labelled.png",
  "path_to_images/null_DEG_volcano_logcutoff_labelled.png"
)

# Read in the images
valid_images <- lapply(image_files, image_read)

# Get the dimensions of the images
image_width <- image_info(valid_images[[1]])$width
image_height <- image_info(valid_images[[1]])$height

# Define the number of columns and rows for the grid
n_cols <- 4
n_rows <- ceiling(length(valid_images) / n_cols)

# Create a blank canvas with transparent background large enough to hold the images
final_width <- n_cols * image_width
final_height <- n_rows * image_height
blank_canvas <- image_blank(final_width, final_height, color = "transparent")  # Transparent background

# Loop through each image and place it on the canvas
for (i in seq_along(valid_images)) {
  # Calculate the row and column position for each image
  row <- ceiling(i / n_cols) - 1
  col <- (i - 1) %% n_cols
  
  # Calculate x and y offsets for the current image
  x_offset <- col * image_width
  y_offset <- row * image_height
  
  # Composite the image onto the blank canvas at the calculated position
  blank_canvas <- image_composite(blank_canvas, valid_images[[i]], 
                                  offset = paste0("+", x_offset, "+", y_offset), operator = "over")
}

# Save the final combined image
output_path <- "desired_output_path/combined_volcano_plots.png"
image_write(blank_canvas, path = output_path, format = "png", density = "1000x1000")

# Print message on success
cat("Combined image saved at:", output_path, "with 600 DPI resolution.\n")


