```


```{r}
# Calculate the top 10% threshold for LFC
up_cutoff <- quantile(abs(tlo1_merged_data$log2FoldChange[tlo1_merged_data$diff_expression == "Upregulated"]), 0.85, na.rm = TRUE)
down_cutoff <- quantile(abs(tlo1_merged_data$log2FoldChange[tlo1_merged_data$diff_expression == "Downregulated"]), 0.85, na.rm = TRUE)

# Get the most significant genes based on p-value (top 10 lowest padj) but only significant ones
significant_genes <- tlo1_merged_data %>%
  filter(diff_expression != "Non-significant") %>%
  arrange(padj) %>%
  slice_head(n = 10)


# Filter genes based on LFC and p-value criteria, excluding non-significant genes and those within LFC boundaries
top_genes <- tlo1_merged_data %>%
  filter(
    ((diff_expression == "Upregulated" & log2FoldChange >= up_cutoff) |
     (diff_expression == "Downregulated" & log2FoldChange <= -down_cutoff)) &
    (log2FoldChange > 1 | log2FoldChange < -1)  # Exclude genes within LFC boundaries
  ) %>%
  bind_rows(significant_genes) %>%
  filter(diff_expression != "Non-significant") %>%  # Ensure no non-significant genes are included
  distinct(Gene, .keep_all = TRUE)  # Remove duplicates


# Combine the manually selected gene with top genes for labeling
top_genes <- bind_rows(top_genes) %>%
  distinct(Gene, .keep_all = TRUE)



# Volcano plot with conditional label positioning (left for downregulated, right for upregulated)
volcano_plot <- ggplot(tlo1_merged_data, aes(x = log2FoldChange, y = -log10(padj))) +
  geom_point(aes(color = diff_expression), size = 2) +
   scale_color_manual(
    name = "Expression Status",
    values = c("Upregulated" = "red", "Non-significant" = "lightgray", "Downregulated" = "blue"),
    labels = c("Downregulated N=38", "Non-significant", "Upregulated N=28")
  ) +
  theme_minimal(base_size = 20) +
  labs(
    x = "Log2 Fold Change",
    y = "-Log10 Adjusted p-value", 
    title = bquote("DE Genes in" ~ italic("tlo1∆/∆") ~ "vs. WT")
  ) +
  theme(
    plot.title = element_text(face = "bold", size = 24),
    axis.title.x = element_text(size = 20, margin = margin(t = 15)),
    axis.title.y = element_text(size = 20, margin = margin(r = 15)),
    axis.text.x = element_text(size = 20),
    axis.text.y = element_text(size = 20),
    legend.text = element_text(size = 18),
    legend.title = element_text(size = 20)
  ) +
  geom_vline(xintercept = 1, linetype = "dashed") +
  geom_vline(xintercept = -1, linetype = "dashed") +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
  xlim(-5, 5) +
  ylim(-1, 20) +
  # Add labels with lines pointing to the corresponding points and avoid overlap
  geom_text_repel(
    data = top_genes,
    aes(label = Gene, 
        hjust = ifelse(diff_expression == "Downregulated", 1, 
                       ifelse(diff_expression == "Upregulated", 0, NA))), # Position labels left or right
    size = 5,
    box.padding = 0.5,
    point.padding = 0.3,
    nudge_x = 1,
    nudge_y = 0.6,  # Adjust the vertical position for labels
    max.overlaps = Inf,
    segment.size = 0.5,
    segment.color = "gray50",
   segment.curvature = -0.2, # Add slight curvature to segments
  segment.ncp = 3,        # Number of control points on the curve
  segment.angle = 20,     # Angle for segment curvature
  force = 10,             # Increase force to repel labels more strongly
  force_pull = 5          # Pull labels further from points to force lines
  )

# Print the plot
print(volcano_plot)

# Save the plot with ggsave
ggsave("tlo1_DEG_volcano_logcutoff_labelled.png", plot = volcano_plot, width = 10, height = 8, units = "in", dpi = 500)


