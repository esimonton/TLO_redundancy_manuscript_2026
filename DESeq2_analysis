```{r}
#USe shrinkage to get more accurate log2 fold changes 
tlo1_res <- lfcShrink(dds, 
                      contrast = c("genotype", "tlo1", "WT"),
                      type = "ashr")  # Specify apeglm method

#Plot MA plot again
plotMA(tlo1_res, ylim=c(-15,15))
```
```{r}
# Rsults table
mcols(tlo1_res)

head(tlo1_res, n=10)

#We need to control for false positives

summary(tlo1_res)
```

```{r}
#Using a fold-change threshold to sift through the large number of DE genes
tlo1_res <- results(dds, contrast =c("genotype", "tlo1", "WT"))


#reshrink fold changes to get new number of DE genes
tlo1_shrink <- lfcShrink(dds, contrast = c("genotype", "tlo1", 
                                        "WT"), res = tlo1_res, type = "ashr")


#run summary function again
summary(tlo1_shrink)

head(tlo1_shrink)

write.csv(tlo1_shrink, file = "tlo1_shrink.log1.csv") #Download and save .csv with reduced list of DE genes
```

```{r}
#We still have a good amount of NA genes and non-significant values. Only about 700 genes are actually <0.05. 

tlo1_shrink_filtered <- tlo1_shrink[!is.na(tlo1_shrink$padj), ]

head(tlo1_shrink_filtered)
write.csv(tlo1_shrink_filtered, file = "tlo1_shrink_filtered.csv")
```

```{r}
# Next we have to filter out high padj values that we don't care about
# Define thresholds
padj_threshold <- 0.05   # Standard significance threshold
lfc_threshold <- 1       # Log2 fold change threshold (adjust as needed)

# Filter based on adjusted p-value and log2 fold change
tlo1_significant <- tlo1_shrink_filtered[tlo1_shrink_filtered$padj < padj_threshold & 
                                       abs(tlo1_shrink_filtered$log2FoldChange) >= lfc_threshold, ]

head(tlo1_significant)

write.csv(tlo1_significant, file = "tlo1_sig.csv")
```

