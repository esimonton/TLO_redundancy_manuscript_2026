```{r}
# Create DESeq object
#Use the adjusted genotype names in your analysis
# Include any major sources of variation found in the PCA in the design formula
dds <- DESeqDataSetFromMatrix(countData = count_data,
                              colData = metadata,
                              design = ~ genotype)
```

```{r}
#Normalization of raw data that exists in the dds
# This ensures that differences such as gene length and library size and composition will be accounted for
dds <- estimateSizeFactors(dds)

# View the size factors used for normalization
sizeFactors(dds)
```

```{r}
# EXtraction of normalized counts from dds
normalized_counts <- counts(dds, normalized=TRUE)

#View normalized counts
View(normalized_counts)

write.csv(normalized_counts, file = "normalized_counts_align2.csv")
```

```{r}
# Next, we can move on to unsupervised clustering analyses visualization
  # This includes hierarchical clustering heatmaps and PCA plots

# First, we need to log transform the data
  #DEseq2 moderates the variance across the mean

vsd_dds <- vst(dds, blind = TRUE)

```

```{r}
# Hierarchical clustering with correlation heatmaps will tell us how similar the biological replicates are to each other, with 1 being perfect correlation

#Extract the vst matrix from the object
vsd_matrix <- assay(vsd_dds)

# Compute pairwise correlation values
vsd_cor <- cor(vsd_matrix)

View(vsd_cor)
```


```{r}
# Visualize the correlation values with a heatmap
#Save heatmap as .png
png("heatmap_align2.png", width=1000, height=1000)
pheatmap(vsd_cor)
```

```{r}
# Principal component analysis to find greatest variation in the dataset
  #Samples are scored based on their influence on the PCs with more similar gene expression profiles clustering together on the plot
pca_plot <- plotPCA(vsd_dds, intgroup="genotype", returnData=TRUE)

# Perform PCA using prcomp
pca_results <- prcomp(t(assay(vsd_dds)))

# Get the proportion of variance explained by each principal component
percent_var <- pca_results$sdev^2 / sum(pca_results$sdev^2)

# Get the percent variance for PC1 and PC2
percent_var_PC1 <- percent_var[1] * 100
percent_var_PC2 <- percent_var[2] * 100

# Print the results
percent_var_PC1
percent_var_PC2
```

```{r}
# Get the proportion of variance explained by PC3 and PC4
percent_var_PC3 <- pca_results$sdev[3]^2 / sum(pca_results$sdev^2) * 100
percent_var_PC4 <- pca_results$sdev[4]^2 / sum(pca_results$sdev^2) * 100

# Create a data frame for plotting
pca_data <- as.data.frame(pca_results$x)
pca_data$genotype <- colData(vsd_dds)$genotype

```


```{r}
