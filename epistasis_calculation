#Epistasis data predictions 


library(openxlsx)
library(emmeans)
library(dplyr)


#Growth assay epistasis calculations

#choosing input file
in_file <- file.choose()

# getting data from sheets
in_sheets <- openxlsx::getSheetNames(in_file)
df <- lapply(in_sheets, openxlsx::read.xlsx, xlsxFile=in_file)
  
# assigning names to data frame
names(df) <- in_sheets

print(names(df))

in_df <- df # ADDED

library(dplyr)

# Gene1/Gene2 dataset
dko_1_2 <- in_df$Growth %>%
  filter(Genotype %in% c("WT", "Gene1∆/∆", "Gene2∆/∆", "Gene1∆/∆ Gene2∆/∆")) %>%
  mutate(
    TLO34 = ifelse(Genotype %in% c("Gene1∆/∆", "Gene1∆/∆ Gene2∆/∆"), 1, 0),
    TLO2  = ifelse(Genotype %in% c("Gene2∆/∆", "Gene1∆/∆ Gene2∆/∆"), 1, 0)
  )


#Gene1/Gene2 analysis

results_1_2 <- dko_1_2 %>%
  group_by(Condition) %>%
  group_modify(~ {
    
    model <- lm(Phenotype ~ GENE1 * GENE2, data = .x)
    
    # additive expectation
    add_exp <- sum(coef(model)[1:3])/coef(model)[1]
    
    anova_table <- anova(model)
    
    tibble(
      p_GENE1 = anova_table["GENE1", "Pr(>F)"],
      p_GENE2 = anova_table["GENE2", "Pr(>F)"],
      p_interaction = anova_table["GENE1:GENE2", "Pr(>F)"],
      additive_expectation = add_exp
    )
  }) %>%
  ungroup()


