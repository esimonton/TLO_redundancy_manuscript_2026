#Make a chord diagram that demonstrates TLO mutant association with modules (no-null edition)
# Call necessary libraries/install necessary packages
# devtools::install_github("kevinblighe/CorLevelPlot")
# Load necessary library
library(circlize)


# Define module colors (for other modules)
module_colors <- c(
  "MEdarkgrey"      = "darkgrey",
  "MEpink"          = "pink",
  "MEskyblue"       = "skyblue",
  "MEsalmon"        = "salmon",
  "MEsteelblue"     = "steelblue",
