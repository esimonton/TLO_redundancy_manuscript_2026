```{r}
#Combine gene length columns to counts file and save as .csv
#Use file with gene names, lengths, and raw counts to calculate the TPM for the C. albicans genome reads

# Load gene count matrix and gene lengths
# count_matrix: a matrix/data frame of raw counts (genes x samples)
# gene_lengths: a vector of gene lengths in base pairs (same order as count_matrix rows)

# Example: Load raw counts and gene lengths
# Load the CSV file
data <- read.csv("C:/Users/simonton/Downloads/TLO_TPM_expression_YPD30.csv")

# Preview the data
head(data)

# Convert gene lengths to kilobases
data$Length_kb <- data$Length / 1000

# Identify sample columns dynamically (exclude "orf_IDs", "Genes", "Start", "End", etc.)
sample_columns <- colnames(data)[!(colnames(data) %in% c("ORF", "Gene", "Start", "End", "Length", "Length_kb"))]

# Extract raw counts and gene lengths
raw_counts <- data[, sample_columns]
lengths_kb <- data$Length_kb

# Check for invalid values
if (any(is.na(lengths_kb) | lengths_kb == 0)) {
  stop("Gene lengths contain zero or missing values. Check the 'Length' column.")
}
if (!all(sapply(raw_counts, is.numeric))) {
  stop("Raw count columns contain non-numeric values. Check the sample columns.")
}

# Function to calculate TPM
calculate_tpm <- function(counts, lengths_kb) {
  # Step 1: Calculate RPK
  rpk <- sweep(counts, 1, lengths_kb, FUN = "/")
  rpk[is.na(rpk) | is.infinite(rpk)] <- 0
  
  # Step 2: Normalize RPK to TPM
  scaling_factors <- colSums(rpk)
  scaling_factors[scaling_factors == 0] <- NA
  tpm <- sweep(rpk, 2, scaling_factors, FUN = "/") * 1e6
  tpm[is.na(tpm)] <- 0
  
  return(tpm)
}

# Calculate TPM
tpm_matrix <- calculate_tpm(as.matrix(raw_counts), lengths_kb)

# Combine TPM results with gene names
tpm_data <- cbind(Gene = data$Gene, as.data.frame(tpm_matrix))

# Save the TPM data to a CSV file
write.csv(tpm_data, "TPM_normalized_data_all_mutants.csv", row.names = FALSE)

# Preview the first few rows of the resulting TPM data
head(tpm_data)

