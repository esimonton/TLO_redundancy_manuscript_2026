#After the growth curve assay, OD600 values over time can be exported and formatted for use in R as a dataframe

#Step 1: generate minimum doubling time values from raw data table

```{r setup, import}
#This code generates the gc data from raw data in order to process it into a usable format
## Import dataset into RStudio
library(growthcurver)
library(readxl)

#choosing input file
in_file <- file.choose()

# getting data from sheets
in_sheets <- openxlsx::getSheetNames(in_file)
d <- lapply(in_sheets, openxlsx::read.xlsx, xlsxFile=in_file)
  
# assigning names to data frame
names(d) <- in_sheets

print(names(d))
```


```{r output, dataframe}

d <- d$Sheet1

gc_out = gc_out <- SummarizeGrowthByPlate(d)

# If you would like to generate plots for all of the growth curves in your
# plate, then call Growthcurver as follows. You can change the name of 
# the output file "gc_plots.pdf" to something that makes sense for you.
gc_out <- SummarizeGrowthByPlate(d, plot_fit = TRUE, 
                                 plot_file = "gc_plots.pdf")
```


```{r, plot}
# The summary information for each well is listed as a row in the output
# data frame called gc_out.

# We can look at the first few rows in the output using the head command.
tail(gc_out)

print(gc_out)
```
#You will save the doubling times for each replicate for use in the next step

#STEP 2: use doubling times from gc_out to assemble boxplots for visualization


```{r gc_out data import}
#choosing input file
in_file <- file.choose()

# getting data from sheets
in_sheets <- openxlsx::getSheetNames(in_file)
in_df2 <- lapply(in_sheets, openxlsx::read.xlsx, xlsxFile=in_file)
  
# assigning names to data frame
names(in_df2) <- in_sheets

print(names(in_df2))
```
```{r plot-wider, fig.width=12, fig.height=5}
# #plot for doubling time, good for posters/publications

all_dt <- in_df2$Sheet2

col_vec <- c("genotype1"="cyan", "genotype2"="cyan2", "genotype3"="cyan3" #add more samples and assign colors as necessary)

dt_plot <- ggplot(all_dt, aes(x=factor(Genotype, level = c('genotype1', 'genotype2', 'genotype3')), y = t_gen, fill = Genotype)) +
geom_boxplot(width = 0.5, alpha = 0.3, outlier.shape = NA) + 
  geom_jitter(aes(fill = Genotype), size=3, alpha=0.7, width = 0.05, pch = 21, show.legend = FALSE) + 
  scale_y_continuous(limits = c(0,110)) +
  labs(x = "Genotype", y = "Doubling time (min)", title = "Title") +  #change title as needed
  theme(title = element_text(face = "bold"), axis.text.x.bottom = element_text(face = "italic", angle = 45, hjust = 1, vjust = 0.5), axis.title.x = element_text(face = "plain", size=15, margin = margin(t=22)), axis.title.y = element_text(face = "plain", size=15, vjust = 3), axis.text.x = element_text(angle=0, size=15), axis.text.y = element_text(size=15)) + 
  scale_x_discrete(labels = label_wrap(4)) +
  scale_fill_manual(values = col_vec) +
  theme(legend.position="none") + 
  guides(fill = FALSE) +
# Add significance annotations as necessary based on stats test results from data set
  #geom_signif(comparisons = list(c("genotype1", "genotype1")), annotations = c("*"), y_position = 90, tip_length = 0.01, margin_top = 0.2, step_increase = -0.1, textsize = 6, vjust=0.001) +
  coord_cartesian(clip = 'off')  +
  theme(panel.background = element_blank(), axis.line = element_line(colour = "black"))

#View generated plot
dt_plot
```

