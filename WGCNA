nrow(norm.data)
```

```{r}
# Use pvclust per MZA to check sample clustering
library(pvclust)
pvclust <- pvclust(data, method = "euclidean",
                   method.hclust = "complete", nboot = 10)


pvclust.plot <- plot(pvclust)


```


```{r}
# Normalization performed by deseq2
 #create dds
dds_WGCNA <- DESeqDataSetFromMatrix(countData = data,
                                    colData = metadata,
                                    design = ~ 1)  #not specifying model because we want the dds to perform variance stabilizing transformation


#Remove all genes with low counts (< 15) in more than 75% of the samples (72*.075=54)
# Suggested by WGCNA on RNAseq FAQ

dds_WGCNA75 <- dds_WGCNA[rowSums(counts(dds_WGCNA) >= 15) >= 54,]
nrow(dds_WGCNA75) #5627 genes
```


```{r}
# Perform variance stabilization
dds_WGCNA_norm <- vst(dds_WGCNA75)


# Get normalized counts 
WGCNA_norm.counts <- assay(dds_WGCNA_norm) %>%
  t() #WGCNA require row and column names to be transposed 
```

```{r}
# Network construction

# Choose a set of soft-thresholding powers
power <- c(c(1:10), seq(from= 12, to= 50, by = 2))
```

```{r}
# Call network topology and analysis function

sft <- pickSoftThreshold(WGCNA_norm.counts,
                  powerVector = power,
                  networkType = "signed",
                  verbose = 5)


sft.data <- sft$fitIndices
```



```{r}
# You want to focus on the R-square and mean.k columns in the sft.data vector
# You want to ideally choose a power that gives you max R-squared and min k (connectivity)


# Visualization to pick power

a1 <- ggplot(sft.data, aes(Power, SFT.R.sq, label = Power)) +
  geom_point() +
  geom_text(nudge_y = 0.1) +
  geom_hline(yintercept = 0.8, color = 'red') +
  labs(x = 'Power', y = 'Scale free topology model fit, signed R^2') +
  theme_classic()


a2 <- ggplot(sft.data, aes(Power, mean.k., label = Power)) +
  geom_point() +
  geom_text(nudge_y = 0.1) +
  labs(x = 'Power', y = 'Mean Connectivity') +
  theme_classic()


# Visualize the two plots together
grid.arrange(a1, a2, nrow = 2)  # 12 seems to minimize the mean.k with the R-sq being greater than 0.8 (above red line) without being excessively large

# You can experiment with different powers to see how they impact clustering and downstream analysis of your results
```



```{r}
# Next, we want to identify modules

# Convert matrix to numeric

WGCNA_norm.counts[] <- sapply(WGCNA_norm.counts, as.numeric)

soft_power <- 16
temp_cor <- cor
cor <- WGCNA::cor
```


```{r}
# Memory estimate w.r.t blocksize

# May need to tweak the default parameters for your dataset, so look up options for what may work best for you
bwnet <- blockwiseModules(WGCNA_norm.counts,
                 maxBlockSize = 6000, #Amount of genes to run in one block, while taking into account memory access with personal machine
                 TOMType = "signed",
                 power = soft_power, # ~16
                 mergeCutHeight = 0.1, #increasing branch stringency
                 numericLabels = FALSE,
                 randomSeed = 1234,
                 minModuleSize = 20,
                 deepSplit = 3,
                 verbose = 3)

                
```

```{r}
#Check effect of high soft power
table(bwnet$colors)
```

```{r}
# Reassign correlation function to the original correlation function
cor <- temp_cor
```

```{r}
