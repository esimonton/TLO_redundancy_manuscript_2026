```{r}
# Merge the module eigengenes with traits (tlo genotypes)
heatmap.data <- merge(module_eigengenes, traits, by = 'row.names')

# Check the first few rows to ensure it's correct
head(heatmap.data)

# Remove the Row.names column after merging
heatmap.data <- heatmap.data %>%
  column_to_rownames(var = 'Row.names')

# Correlation matrix between module eigengenes and genotypes (tlo mutants)
cor_matrix <- cor(heatmap.data[, 1:33], heatmap.data[, 34:ncol(heatmap.data)], method = "pearson")

# Perform hierarchical clustering on the correlation matrix (for the genotypes)
col_dendrogram <- hclust(dist(t(cor_matrix)), method = "complete")  # Clustering genotypes based on ME associations

# Plot the dendrogram
png("WGCNA_module_trait_dendrogram.png", width=2400, height=1000)

# Plot the dendrogram for the tlo genotypes
plot(col_dendrogram, main = "Hierarchical Clustering of TLO Genotypes Based on Module Eigengene Associations",
     xlab = "Genotypes", ylab = "Distance", sub = "",
     cex.main = 1.5, cex.lab = 1.2, cex.axis = 1.1)

# Close the plot device
dev.off()

```
```{r}
# Save dendrogram construction data for TLOs vs. MEs

write.csv(cor_matrix, file = "TLO_ME_dendro_data.csv")
```



```{r}
#We can calculate the module membership and associated p-values that our association data tells us
# In other words, this can shed light on the differences in gene expression profiles between our different groups

# The module membership/intramodule connectivity is calculated as the correlation of the eigengene and the genes
# This quantifies the similarity of all genes on the array to every module

module.membership.measure <- cor(module_eigengenes, WGCNA_norm.counts, use = 'p')

module.membership.measure.pvalue <- corPvalueStudent(module.membership.measure, nSamples)

module.membership.measure.pvalue[1:10,1:10] # You can further look into the significant genes of interest and dig in more

# Save output as .csv
write.csv(module.membership.measure.pvalue, "WGCNA_module_gene_pvals_no_null.csv")
```


```{r}

#We can plot a 2D figure of the relatedness between the different modules

# Assuming 'bwnet' contains WGCNA results, and 'MEs' are the module eigengenes

# Step 1: Extract module colors (assigned to each gene)
moduleColors <- unique(bwnet$colors)  # Extract unique module colors

# Step 2: Create a named vector where module colors correspond to eigengene names
# Eigengenes typically have names like "MEblue", "MEturquoise", etc.
eigengeneColors <- setNames(moduleColors, paste0("ME", moduleColors))

# Step 3: Assign colors to eigengenes
moduleEigengeneColors <- eigengeneColors[names(module_eigengenes)]  # Match colors to the eigengene names

# Step 4: Perform multidimensional scaling (MDS)
dissMEs <- (1 - cor(module_eigengenes, use = "p")) / 2  # Dissimilarity between module eigengenes
cmd1 <- cmdscale(as.dist(dissMEs), k = 2)  # Perform MDS


# Open a PNG device
png("MDS_plot_no_null.png", width = 800, height = 600)

# Step 5: Plot MDS with manually assigned colors
plot(cmd1, 
     col = moduleEigengeneColors,  # Use the manually assigned colors
     pch = 19,                     # Solid points
     xlab = "Scaling Dimension 1", 
     ylab = "Scaling Dimension 2",
     main = "MDS Plot of Module Eigengenes with Manual Colors")

# Optionally add labels for each module
text(cmd1, labels = names(module_eigengenes), pos = 3, cex = 0.8, col = "black")

# Close the device to save the file
dev.off()
```



