```{r}
#prepare expression data
#Genes need to be in columns and samples need to be in rows , so we need to transpose the data

norm.data <- count_data

gsg <- goodSamplesGenes(t(norm.data))
summary(gsg)

#Evaluate outliers
gsg$allOK

#Need to exclude the outlier genes and check the samples

