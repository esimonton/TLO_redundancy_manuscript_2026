```{r}
# Moving forward, it seems normal to use merged output?

#We want to compare gene modules to associated traits (in our case, genotypes)
# The closest to a binary condition we have is non-mutant (WT) vs mutant (tlo deletions and null)

# Relate modules to traits
# Module trait associations 
tlo_sample_metadata <- read.csv("tlo_sample_metadata_no_null.csv", row.names = 1 )


colData <- tlo_sample_metadata

# Create traits file - binarize categorical variables
traits <- colData %>%
  mutate(Condition_bin = ifelse(grepl('Mutant', Condition), 1, 0)) %>%
  dplyr::select(4)


# We may also want to view modules based on what kind of mutant we have (alpha, beta, gamma, etc)
  # To do this, we must create a new column for each subcondition, where each column has one variable as 1 and the rest as 0
```

```{r}
# Convert your categorical variable into a factor
colData$tlo_mutant <- factor(colData$tlo_mutant, levels = c("WT", "a1", "a3", "a34", "a9", "a10", "a12", "b2", "g4", "g5", "g7", "g8", "g11", "g13", "g16", "a34.b2", "a9.a10"))

# Binarize the categorical column
tlo_mutant.out <- binarizeCategoricalColumns(colData$tlo_mutant,
                           includePairwise = FALSE,
                           includeLevelVsAll = TRUE,
                           levelOrder = NULL,
                           minCount = 1)

# View the result with Genotype included
View(tlo_mutant.out)
```


```{r}
# Combine the condition_type data with the traits data so it's all in one data frame

traits <- cbind(traits, tlo_mutant.out) # these traits with be used to associate with the expression data modules



# Define number of genes and samples

nSamples <- nrow(WGCNA_norm.counts)
nGenes <- ncol(WGCNA_norm.counts)


module.trait.corr <- cor(module_eigengenes, traits, use = 'p')  #This uses Pearson correlation (we are using association relationships that are significant between modules)
module.trait.corr.pvalues <- corPvalueStudent(module.trait.corr, nSamples)
  view(module.trait.corr.pvalues)

# We can also view the module correlations as a heatmap
```


