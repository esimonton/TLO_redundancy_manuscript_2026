                      ))
)


```

```{r}
# Load DESeq2
library(DESeq2)

# Create DESeq2 object
dds <- DESeqDataSetFromMatrix(countData = count_data, colData = metadata, design = ~ genotype)

# Estimate size factors for normalization
dds <- estimateSizeFactors(dds)

```


```{r}
# Apply VST transformation
vsd <- vst(dds, blind=TRUE)  # blind=TRUE to ignore design formula

# Extract normalized, transformed data
mat <- assay(vsd)

```


```{r}
# Extract normalized expression matrix
vst_counts <- assay(vsd)

# Calculate mean expression for each genotype
library(dplyr)

# Add genotype info to the counts
vst_data <- as.data.frame(vst_counts)
vst_data$gene <- rownames(vst_data)
vst_data_long <- tidyr::gather(vst_data, key="sample", value="expression", -gene)

# Merge with metadata to associate samples with genotypes
vst_data_long <- merge(vst_data_long, metadata, by.x="sample", by.y="sample")

# Calculate mean expression for each gene and genotype
mean_expression <- vst_data_long %>%
  group_by(gene, genotype) %>%
  summarize(mean_expression = mean(expression))

# Pivot back to wide format (genotypes as columns, genes as rows)
mean_expression_wide <- tidyr::spread(mean_expression, key=genotype, value=mean_expression)


write.csv(mean_expression_wide, file = "global_heatmap_mean_expression_YPD30.csv")
```


```{r}
# Subtract WT mean expression from all other genotypes
wt_means <- mean_expression_wide$WT

# Center data by subtracting WT expression from each column
mean_expression_centered <- mean_expression_wide
mean_expression_centered[-1] <- sweep(mean_expression_wide[-1], 1, wt_means)


write.csv(mean_expression_centered, file = "global_heatmap_relative_expression_YPD30.csv")
```




```{r}
library(pheatmap)

# Clip the heatmap data to the range -2 to 2
