```

```{r}
#Using the combined DEG file "dKO_LFC_comparison.xlsx" where each Sheet is the tlo genotype name the script pulls



# Convert list of dataframes into a single dataframe
combined_df <- bind_rows(in_df, .id = "Genotype")

# Check the structure of combined_df to confirm column names
str(combined_df)

```



```{r}
# Select only Gene and relevant LFC values explicitly using dplyr::select()

library(dplyr)
library(tidyr)
library(pheatmap)

# Prepare LFC data
lfc_data <- combined_df %>%
  filter(Genotype %in% c("tlo34", "tlo2", "tlo34.tlo2")) %>%
  dplyr::select(Gene, Genotype, log2FoldChange) %>%
  pivot_wider(names_from = Genotype, values_from = log2FoldChange)

lfc_data <- lfc_data %>% filter(rowSums(is.na(.[-1])) < ncol(.[-1]))

# Convert to matrix
lfc_matrix <- as.matrix(lfc_data[, -1])
rownames(lfc_matrix) <- lfc_data$Gene
lfc_matrix[is.na(lfc_matrix) | is.nan(lfc_matrix) | is.infinite(lfc_matrix)] <- 0

# Rename columns
colnames(lfc_matrix)[colnames(lfc_matrix) == "tlo34.tlo2"] <- "tlo34∆/∆ tlo2∆/∆"
colnames(lfc_matrix)[colnames(lfc_matrix) == "tlo34"] <- "tlo34∆/∆"
colnames(lfc_matrix)[colnames(lfc_matrix) == "tlo2"] <- "tlo2∆/∆"

# Reorder columns manually
lfc_matrix <- lfc_matrix[, c( "tlo34∆/∆", "tlo2∆/∆", "tlo34∆/∆ tlo2∆/∆")]

# Optional: italicize gene names (rows)
rownames(lfc_matrix) <- paste0("italic('", rownames(lfc_matrix), "')")

# Define x-axis (column) labels as expressions
col_labels <- parse(text = c("italic('tlo34∆/∆')",
                             "italic('tlo2∆/∆')",
                             "italic('tlo34∆/∆ tlo2∆/∆')"))

# Save heatmap
png("heatmap_LFC_comparison_tlo34_tlo2dKO_delta.png", width = 13, height = 14, units = "in", res = 600)


pheatmap(lfc_matrix, 
         cluster_rows = TRUE,  
         cluster_cols = FALSE,  # maintain specified column order
         color = colorRampPalette(c("blue", "skyblue", "white", "pink", "red"))(100),  
         scale = "none",
         main = expression("LFC Comparison of" ~ italic("tlo34, tlo2") ~ " and " ~ italic("tlo34/tlo2") ~ "Differentially Expressed Genes"),
         fontsize = 20,
         angle_col = 45,
         na_col = "gray70",
         breaks = seq(-5, 5, length.out = 101),
         labels_col = col_labels,  # italic x-axis labels
         labels_row = parse(text = rownames(lfc_matrix)))  # italic y-axis labels

dev.off()

