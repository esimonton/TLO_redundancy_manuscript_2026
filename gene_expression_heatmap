# Sample names
samples <- c("WT-2", "WT-4", "WT-5", "WT-6",
             "null-1", "null-2", "null-3", "null-4",
             "tlo34-1", "tlo34-2", "tlo34-3", "tlo34-4",
             "tlo2-1", "tlo2-2", "tlo2-3", "tlo2-4",
             "tlo3-1", "tlo3-2", "tlo3-3", "tlo3-4",
             "tlo16-1", "tlo16-2", "tlo16-3", "tlo16-4",
             "tlo1-1", "tlo1-2", "tlo1-3", "tlo1-4",
             "tlo4-1", "tlo4-2", "tlo4-3", "tlo4-4",
             "tlo11-1", "tlo11-2", "tlo11-3", "tlo11-4",
             
             "tlo5-1", "tlo5-2", "tlo5-3", "tlo5-4",
             "tlo7-1", "tlo7-2", "tlo7-3", "tlo7-4",
