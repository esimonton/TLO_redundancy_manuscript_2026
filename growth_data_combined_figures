  "WT" = "transparent"
)

genotype_order <- c(
  "wt", "tlo9∆", "tlo10∆", "tlo9∆/tlo10∆")

# Load necessary libraries
library(tidyverse)
#install.packages("ggbeeswarm")  # if not already installed
library(ggbeeswarm)

# STEP 1: Read in your data (preserve "No growth" and text)
df <- read_csv(filepath, col_types = cols(.default = col_character()))

# STEP 2: Convert to long format
df_long <- df %>%
  pivot_longer(cols = -Genotype, names_to = "Condition", values_to = "DT_raw") %>%
  mutate(
    DT = as.numeric(DT_raw),                         # Converts numbers, keeps NA for "No growth"
    label = ifelse(DT_raw == "No growth", "No growth", NA),
    Genotype = str_to_lower(Genotype),                # Ensure lowercase for coloring
    Condition = factor(Condition, levels = c("YPD30°C", "SCD30°C", "YPM30°C", "YPD37°C", "Lactate37°C", "Acetate37°C", "YPD42°C", "tBOOH", "LowPO4", "CFW"))  # Specify order of conditions
  )

# STEP 3: Calculate WT means per condition
wt_means <- df_long %>%
  filter(Genotype == "wt", !is.na(DT)) %>%
  group_by(Condition) %>%
  summarise(wt_mean = mean(DT), .groups = "drop")

# STEP 4: Normalize DT values to WT
df_norm <- df_long %>%
  left_join(wt_means, by = "Condition") %>%
  mutate(norm_dt = DT / wt_mean)

# STEP 5: Calculate the mean normalized DT per Genotype and Condition
df_norm_mean <- df_norm %>%
  group_by(Genotype, Condition) %>%
  summarise(
    mean_norm_dt = mean(norm_dt, na.rm = TRUE),   # Calculate the mean normalized doubling time
    .groups = "drop"
  )
# Make Genotype a factor with your custom order
df_norm_mean$Genotype <- factor(df_norm_mean$Genotype, levels = genotype_order)

# STEP 6: Add custom TLO genotype colors
tlo_colors <- c(
