  "wt" = "transparent"
)

# STEP 5.5: Mark significant points by joining with sig_list
sig_list <- tribble(
  ~Genotype,       ~Condition,

  "tlo9∆/tlo10∆",      "tBOOH",
  "tlo9∆/tlo10∆",     "YPD42°C",
  "tlo9∆/tlo10∆",   "LowPO4",
  "tlo9∆/tlo10∆",   "Lactate37°C"
)

# Add the significance flag to the data
df_norm_mean <- df_norm_mean %>%
  left_join(sig_list %>% mutate(significant = TRUE), by = c("Genotype", "Condition")) %>%
  mutate(
    significant = ifelse(is.na(significant), FALSE, significant),  # Default to FALSE for non-significant
    outline_color = ifelse(significant, "black", NA),              # Only outline for significant points
    stroke_val = ifelse(significant, 1.2, 0)                       # Stroke size for significant points
  )

# Ensure that Condition is a factor and properly ordered
df_norm_mean$Condition <- factor(df_norm_mean$Condition, levels = c("YPD30°C", "SCD30°C", "YPM30°C", "YPD37°C", "Lactate37°C", "Acetate37°C", "YPD42°C", "tBOOH", "LowPO4", "CFW"))


# Make Genotype a factor with your custom order
df_norm_mean$Genotype <- factor(df_norm_mean$Genotype, levels = genotype_order)

