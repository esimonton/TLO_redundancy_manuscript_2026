# Ensure all data points are included and only significant points have an outline and color change
ggplot(df_norm_mean, aes(x = Condition, y = mean_norm_dt)) +
  geom_quasirandom(
    aes(
      fill = Genotype,
      color = ifelse(significant, "black", "transparent"),  # Non-significant points will have a white outline
      stroke = ifelse(significant, 1.5, 1.5)           # Stroke size 1.2 for non-significant points
    ),
    shape = 21,
    size = 2.8,
