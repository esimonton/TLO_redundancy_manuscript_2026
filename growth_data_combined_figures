```{r}
# Load necessary libraries
library(tidyverse)
#install.packages("ggbeeswarm")  # if not already installed
library(ggbeeswarm)

# STEP 1: Read in your data (preserve "No growth" and text)
df <- read_csv(filepath, col_types = cols(.default = col_character()))

# STEP 2: Convert to long format
df_long <- df %>%
  pivot_longer(cols = -Genotype, names_to = "Condition", values_to = "DT_raw") %>%
  mutate(
    DT = as.numeric(DT_raw),                         # Converts numbers, keeps NA for "No growth"
    label = ifelse(DT_raw == "No growth", "No growth", NA),
    Genotype = str_to_lower(Genotype),                # Ensure lowercase for coloring
    Condition = factor(Condition, levels = c("YPD30°C", "SCD30°C", "YPM30°C", "YPD37°C", "Lactate37°C", "Acetate37°C"))  # Specify order of conditions
  )

# STEP 3: Calculate WT means per condition
wt_means <- df_long %>%
  filter(Genotype == "wt", !is.na(DT)) %>%
  group_by(Condition) %>%
  summarise(wt_mean = mean(DT), .groups = "drop")

# STEP 4: Normalize DT values to WT
df_norm <- df_long %>%
  left_join(wt_means, by = "Condition") %>%
  mutate(norm_dt = DT / wt_mean)

# STEP 5: Calculate the mean normalized DT per Genotype and Condition
df_norm_mean <- df_norm %>%
  group_by(Genotype, Condition) %>%
  summarise(
    mean_norm_dt = mean(norm_dt, na.rm = TRUE),   # Calculate the mean normalized doubling time
    .groups = "drop"
  )
# Make Genotype a factor with your custom order
df_norm_mean$Genotype <- factor(df_norm_mean$Genotype, levels = genotype_order)

# STEP 6: Add custom genotype colors
tlo_colors <- c(
  "tlo34∆/∆" = "cyan3", "tlo2∆/∆" = "yellow", "tlo34∆/∆/tlo2∆/∆" = "green3", "tlo9∆/tlo10∆" = "darkblue",
  "tlo3∆/∆" = "cyan2", "tlo9∆" = "cyan4", "tlo10∆" = "deepskyblue", "tlo12∆/∆" = "dodgerblue",
  "tlo1∆/∆" = "cyan", "tlo4∆/∆" = "magenta", "tlo5∆/∆" = "magenta1", "tlo7∆/∆" = "magenta2",
  "tlo8∆/∆" = "magenta3", "tlo11∆/∆" = "magenta4", "tlo13∆/∆" = "darkorchid", "tlo16∆/∆" = "orchid",
  "tlo∆/∆" = "gray", "WT" = "transparent"
)

# STEP 5.5: Mark significant points by joining with sig_list
sig_list <- tribble(
  ~Genotype,       ~Condition,
  "tlo∆/∆",      "YPD30°C",
  "tlo∆/∆",      "SCD30°C",
  "tlo∆/∆",      "YPD37°C",
  "tlo∆/∆",      "YPM30°C",
  "tlo10∆",         "YPD37°C",
  "tlo2∆/∆",          "YPD37°C",
  "tlo5∆/∆",          "YPD37°C",
  "tlo7∆/∆",          "YPD37°C",
  "tlo8∆/∆",          "YPD37°C",
  "tlo11∆/∆",         "YPD37°C",
  "tlo12∆/∆",         "YPM30°C",
  "tlo9∆",          "Lactate37°C",
  "tlo10∆/∆",         "Lactate37°C",
  "tlo12∆/∆",         "Lactate37°C",
  "tlo8∆/∆",          "Lactate37°C",
  "tlo13∆/∆",         "Lactate37°C",
  "tlo16∆/∆",         "Lactate37°C",
  "tlo9∆",          "Acetate37°C",
  "tlo16∆/∆",         "Acetate37°C"
)

# Add the significance flag to the data
df_norm_mean <- df_norm_mean %>%
  left_join(sig_list %>% mutate(significant = TRUE), by = c("Genotype", "Condition")) %>%
  mutate(
    significant = ifelse(is.na(significant), FALSE, significant),  # Default to FALSE for non-significant
    outline_color = ifelse(significant, "black", NA),              # Only outline for significant points
    stroke_val = ifelse(significant, 1.2, 0)                       # Stroke size for significant points
  )

# Ensure that Condition is a factor and properly ordered
df_norm_mean$Condition <- factor(df_norm_mean$Condition, levels = c("YPD30°C", "SCD30°C", "YPM30°C", "YPD37°C", "Lactate37°C", "Acetate37°C"))


# Make Genotype a factor with your custom order
df_norm_mean$Genotype <- factor(df_norm_mean$Genotype, levels = genotype_order)

# STEP 7: Plot!
# Ensure all data points are included and only significant points have an outline and color change
ggplot(df_norm_mean, aes(x = Condition, y = mean_norm_dt)) +
  geom_quasirandom(
    aes(
      fill = Genotype,
      width = 0.1,
      color = ifelse(significant, "black", "transparent"),  # Non-significant points will have a white outline
      stroke = ifelse(significant, 1.2, 1.2)           # Stroke size 1.2 for non-significant points
    ),
    shape = 21,
    size = 2.8,
    groupOnX = TRUE
  ) +
  geom_hline(yintercept = 1, linetype = "solid", color = "black", size = 0.8) +
  scale_fill_manual(values = tlo_colors) +
  scale_color_identity() +  # Use color set above
  labs(
    title = "Mutant growth across various carbon sources",
    x = "Condition",
    y = "Doubling Time (relative to WT)",
    fill = "Genotype"
  ) +
  theme_minimal(base_size = 20) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "right",
    legend.title = element_text(face = "bold"),
    legend.text = element_text(face = "italic")
  ) +
  expand_limits(y = c(0, max(df_norm_mean$mean_norm_dt, na.rm = TRUE) * 1.1))  # Adjust y-axis


