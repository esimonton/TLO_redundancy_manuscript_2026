#Run simple paired t-test for all conditions for each dKO group, since each condition has a paired predicted and actual phenotype value
library(dplyr)

# Make sure everything is numeric
dko1_df <- dKO1 %>%
  mutate(
    predicted_dKO = as.numeric(predicted_dKO),
    actual_dKO = as.numeric(actual_dKO)
  )

# Function to run t-test and handle missing values
run_ttest_correct <- function(sub_df) {
  # Only use rows where both values are present
  clean_df <- sub_df %>%
    filter(!is.na(predicted_dKO) & !is.na(actual_dKO))
  
  # Pull vectors
  pred <- clean_df$predicted_dKO
  actual <- clean_df$actual_dKO
  
  # Decide test type
  test <- if (length(pred) == length(actual)) {
    t.test(pred, actual, paired = TRUE)
  } else {
    t.test(pred, actual, paired = FALSE)
  }

  return(list(
    test = test,
    n_pred = sum(!is.na(sub_df$predicted_dKO)),
    n_actual = sum(!is.na(sub_df$actual_dKO)),
    n_used = nrow(clean_df),
    paired = length(pred) == length(actual),
    p_value = test$p.value,
    t_stat = test$statistic,
    conf_low = test$conf.int[1],
    conf_high = test$conf.int[2],
    mean_pred = mean(pred),
    mean_actual = mean(actual)
  ))
}

# Apply per condition
t_test_results <- dko1_df %>%
  group_by(Condition) %>%
  group_map(~{
    result <- run_ttest_correct(.x)
    tibble(
      Condition = .y$Condition,  # FIX: get Condition from grouping variable
      n_pred = result$n_pred,
      n_actual = result$n_actual,
      n_used = result$n_used,
      paired = result$paired,
      p_value = result$p_value,
      t_stat = result$t_stat,
      conf_low = result$conf_low,
      conf_high = result$conf_high,
      mean_pred = result$mean_pred,
      mean_actual = result$mean_actual
    )
  }) %>%
  bind_rows()


# Export to CSV
write.csv(t_test_results, "t_test_results_dKO1.csv", row.names = FALSE)
