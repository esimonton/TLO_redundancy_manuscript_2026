#Figure out the threshold of significance for the MEs
n <- 17  # number of genotypes
alpha <- 0.05
F_crit <- qf(1 - alpha, df1 = 1, df2 = n - 2)
R2_threshold <- F_crit / (F_crit + (n - 2))

print(paste("Theoretical R² threshold at alpha =", alpha, "is", round(R2_threshold, 3)))
```

