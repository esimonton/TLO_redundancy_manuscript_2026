#Since we lose significance by correction, let's record and sort by suggestive results (R2 >.23, FDR<.1)
suggestive_results <- results_df %>%
  filter(R_squared > 0.3, FDR < .1) %>%
  arrange(desc(R_squared))


results_df <- results_df %>%
  mutate(Significance = case_when(
    FDR < 0.05 ~ "Significant (FDR < 0.05)",
    R_squared > 0.3 ~ "Suggestive (R² > 0.3)",
    TRUE ~ "Not significant"
  ))
