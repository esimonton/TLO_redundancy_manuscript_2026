```{r}
library(dplyr)
library(tidyr)

# Make sure Genotype is a column in both tibbles
# (If it’s a rowname, convert to a column first)
# trait_df <- tibble::rownames_to_column(trait_df, var = "Genotype")
# ME_df <- tibble::rownames_to_column(ME_df, var = "Genotype")

# Initialize results dataframe
results_df <- tibble(
  Trait = character(),
  Module = character(),
  Slope = numeric(),
  R_squared = numeric(),
  P_value = numeric()
)

# Loop over traits and MEs (exclude Genotype column)
for (trait in setdiff(colnames(trait_df), "Genotype")) {
  for (ME in setdiff(colnames(ME_df), "Genotype")) {
    combined <- inner_join(
      trait_df %>% select(Genotype, all_of(trait)),
      ME_df %>% select(Genotype, all_of(ME)),
      by = "Genotype"
    ) %>%
      drop_na()

    if (nrow(combined) > 2) {  # need enough points to fit
      model <- lm(reformulate(ME, response = trait), data = combined)
      summ <- summary(model)
      slope <- coef(model)[2]
      r2 <- summ$r.squared
      pval <- coef(summ)[2, 4]

      results_df <- results_df %>%
        add_row(
          Trait = trait,
          Module = ME,
          Slope = slope,
          R_squared = r2,
          P_value = pval
        )
    }
  }
}

# Optional: Adjust p-values for multiple testing (FDR)
results_df <- results_df %>%
  mutate(P_adj = p.adjust(P_value, method = "fdr"))

results_df$FDR <- p.adjust(results_df$P_value, method = "fdr")

# Save results to CSV
write.csv(results_df, "WGCNA_trait_ME_regression_results.csv", row.names = FALSE)

# Done!
print("Regression results saved to WGCNA_trait_ME_regression_results.csv")
```

```{r}
#Next we can visualize the association and clustering between the MEs and phenotypes
library(dplyr)
library(tidyr)
library(pheatmap)
library(tibble)
library(ggplot2)

# Pivot your results_df to matrix of R_squared values:
r2_mat <- results_df %>%
  select(Trait, Module, R_squared) %>%
  pivot_wider(names_from = Module, values_from = R_squared) %>%
  column_to_rownames(var = "Trait") %>%
  as.matrix()

# Replace NA with 0 (means no explanatory power)
r2_mat[is.na(r2_mat)] <- 0

# Plot heatmap with clustering
heatmap <- pheatmap(r2_mat,
         cluster_rows = TRUE,
         cluster_cols = TRUE,
         scale = "none",
         main = "Phenotype clustering by ME association (R²)",
         fontsize_row = 10,
         fontsize_col = 10,
         color = colorRampPalette(c("white", "yellow", "red"))(50) 
         )
print(heatmap)

ggsave("ME_trait_heatmap_R2.png", dpi = 300)
```
