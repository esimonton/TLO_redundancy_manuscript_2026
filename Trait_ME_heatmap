```{r}
#Annotate the heatmap based on these thresholds
heatmap_data <- results_df %>%
  mutate(Significance = case_when(
    FDR < 0.05 ~ "Significant",
    R_squared > 0.3 ~ "Suggestive",
    TRUE ~ "Not significant"
  ))

library(ggplot2)

heatmap_plot <- ggplot(heatmap_data, aes(x = Trait, y = Module, fill = R_squared)) +
  geom_tile(color = "white") +
  scale_fill_gradient2(
    low = "white", mid = "lightblue", high = "blue", midpoint = 0.3,
    name = "R²"
  ) +
  geom_text(aes(label = ifelse(Significance == "Significant", "*",
                        ifelse(Significance == "Suggestive", "•", ""))),
            color = "black", size = 4) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  labs(title = "Module–Trait Association Heatmap",
       subtitle = "R² values with markers for significance (* = FDR < 0.05, • = R² > 0.3)")

print(heatmap_plot)

ggsave("ME_trait_heatmap.png", heatmap_plot, width = 8, height = 6, dpi = 300)

