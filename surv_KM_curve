color_list = c("PBS"="darkgreen", "WT"="gray1", "tlo∆/∆"="gray", "tlo3∆/∆"="cyan2", "tlo34∆/∆"="cyan3", "tlo2∆/∆"="yellow", "tlo7∆/∆"="magenta2")

strain_list = c('PBS', 'WT', 'tlo∆/∆', 'tlo3∆/∆', 'tlo34∆/∆', 'tlo2∆/∆', 'tlo7∆/∆')

in_df$TLO_sub$Genotype <- factor(in_df$TLO_sub$Genotype,
                                 levels = names(color_list))

#Fitting the survival curves
L_km_fit <- survfit(Surv(Days, Status) ~ Genotype, data = in_df$TLO_sub)

#summary(L_km_fit)

L_km_plot <- ggsurvplot(L_km_fit, data = in_df$TLO_sub, 
                        palette = color_list,
                        legend.title = element_blank(),
                        legend = "right", legend.labs = legend_labels,
                        xlim = c(0, 7),  # Ensure full range is shown
                        break.time.by = 1,  # Show every integer day
                        ggtheme = theme_minimal(base_size = 28)+
                            theme(panel.grid.major.x = element_blank(),  # Remove vertical grid lines
                            panel.grid.minor.x = element_blank()),
                        title = "Galleria mellonella infection with TLO mutants",
                        xlab = "Days post-infection",
                        ylab = "Fractional survival"
                        )
L_km_plot

# Save the Kaplan-Meier plot as a TIFF file with specific dimensions
ggsave("KM_curves.tiff", plot = L_km_plot$plot, device = 'tiff', dpi = 600, width = 10, height = 6)


