```{r}
#Download required libraries/dependencies
library(survival)
library(survminer)
```
```{r}
#choosing input file
in_file <- file.choose()

# getting data from sheets
in_sheets <- openxlsx::getSheetNames(in_file)
in_df <- lapply(in_sheets, openxlsx::read.xlsx, xlsxFile=in_file)
  
# assigning names to data frame
names(in_df) <- in_sheets

print(names(in_df))
```

```{r}
#Do post-hoc log-rank test for all samples first
pairwise_comp_all <- pairwise_survdiff(Surv(Days, Status) ~ Genotype, data = in_df$TLO_comb, p.adjust.method = "BH")

pairwise_comp_all


# Extract p-values comparing each mutant to WT
p_values_vs_wt <- pairwise_comp_all$p.value["WT", , drop = FALSE]
# Filter only significant ones (e.g., p < 0.05)
sig_p_all <- p_values_vs_wt[!is.na(p_values_vs_wt) & p_values_vs_wt < 0.05]
sig_p_all
```

```{r}
#Save output
# Load required libraries
library(survival)
library(dplyr)
library(tidyr)

# Run the pairwise log-rank test
pairwise_comp_all <- pairwise_survdiff(
  Surv(Days, Status) ~ Genotype,
  data = in_df$TLO_comb,
  p.adjust.method = "BH"
)

# Extract the pairwise p-values matrix
pval_matrix <- pairwise_comp_all$p.value

# Convert to tidy long-format data frame
pairwise_df <- as.data.frame(as.table(pval_matrix)) %>%
  rename(Genotype1 = Var1, Genotype2 = Var2, p_value = Freq) %>%
  filter(!is.na(p_value))

# View results
print(pairwise_df)

# Save to CSV
write.csv(pairwise_df, "pairwise_logrank_results.csv", row.names = FALSE)

```

