# Define genotype colors
genotype_colors <- c(
    "WT" = "gray1", "tlo12∆/∆" = "dodgerblue", "tlo9/tlo10" = "darkblue", "tlo13∆/∆" = "darkorchid", "tlo9∆" = "cyan4",
    "tlo3∆/∆" = "cyan2", "tlo2∆/∆" = "yellow", "tlo34∆/∆" = "cyan3", "tlo1∆/∆" = "cyan", "tlo4∆/∆" = "magenta", 
    "tlo10∆" = "deepskyblue", "tlo8∆/∆" = "magenta3", "tlo11∆/∆" = "magenta4", 
    "tlo34/tlo2" = "green3", "tlo16∆/∆" = "orchid", "tlo5∆/∆" = "magenta1", "tlo7∆/∆" = "magenta2", "tlo∆/∆" = "gray"
)

# Ensure "Upregulation" is above "Downregulation" in the legend
regulation_long_df$variable <- factor(regulation_long_df$variable, levels = c("Increased", "Decreased"))

# Create a separate data frame for the color bar
genotype_bar_df <- data.frame(
  Genotype = unique(regulation_long_df$Genotype),
  y = -max(regulation_long_df$value) * 0.1  # Position below x-axis
)

# Create base dot plot
dot_plot_DE <- ggplot(regulation_long_df, aes(x = Genotype, y = value, color = variable)) +
  geom_point(size = 4) +

  # Add color bar below x-axis (with inherit.aes = FALSE)
  geom_tile(data = genotype_bar_df, 
            aes(x = Genotype, y = y, fill = Genotype), 
            height = max(regulation_long_df$value) * 0.04, width = 0.8, inherit.aes = FALSE) +

  theme_minimal() +
  labs(
    title = "Number of Up and Down-Regulated DEGs by Genotype",
    x = "Genotype",
    y = "Number of DEGs",
    color = "Regulation",
    fill = "Genotype"
  ) +

  theme(
    axis.text.x = element_text(size = 20, angle = 45, hjust = 1, face = "italic"),
    axis.text.y = element_text(size = 20),
    axis.title.x = element_text(size = 20, face = "bold"),
    axis.title.y = element_text(size = 20, face = "bold"),
    plot.title = element_text(size = 20, hjust = 0.5, face = "bold"),
    legend.text = element_text(size = 18),
    legend.title = element_text(size = 20, face = "bold"),
    legend.position = "right"  # Move legend below the x-axis
  ) +

  scale_color_manual(values = c("Decreased" = "blue", "Increased" = "red")) +
  scale_fill_manual(values = genotype_colors, guide = "none") +  # Apply genotype colors but remove extra legend
  scale_x_discrete(labels = custom_labels)

print(dot_plot_DE)

```

